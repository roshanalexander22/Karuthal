{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "User",
  "type": "object",
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "email": { "type": "string", "format": "email" },
    "full_name": { "type": "string" },
    "phone": { "type": "string" },
    "language_preference": { "type": "string", "enum": ["ml", "en"] }
  },
  "required": ["id", "email", "full_name"]
}
