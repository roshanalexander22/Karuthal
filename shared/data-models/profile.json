{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PersonalProfileField",
  "type": "object",
  "properties": {
    "field_name": { "type": "string" },
    "field_value": { "type": "string" },
    "field_type": { "type": "string" },
    "is_verified": { "type": "boolean" },
    "confidence_score": { "type": "number" }
