{
  "$defs": {
    "TokenResponse": {
      "description": "JWT token pair returned on successful login or refresh.",
      "properties": {
        "access_token": {
          "title": "Access Token",
          "type": "string"
        },
        "refresh_token": {
          "title": "Refresh Token",
          "type": "string"
        },
        "token_type": {
          "default": "bearer",
          "title": "Token Type",
          "type": "string"
        },
        "expires_in": {
          "description": "Access token TTL in seconds.",
          "title": "Expires In",
          "type": "integer"
        }
      },
      "required": [
        "access_token",
        "refresh_token",
        "expires_in"
      ],
      "title": "TokenResponse",
      "type": "object"
    },
    "UserResponse": {
      "description": "Public user representation returned after registration or login.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "email": {
          "format": "email",
          "title": "Email",
          "type": "string"
        },
        "full_name": {
          "title": "Full Name",
          "type": "string"
        },
        "phone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phone"
        },
        "language_preference": {
          "title": "Language Preference",
          "type": "string"
        },
        "is_active": {
          "title": "Is Active",
          "type": "boolean"
        },
        "is_verified": {
          "title": "Is Verified",
          "type": "boolean"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "email",
        "full_name",
        "language_preference",
        "is_active",
        "is_verified",
        "created_at"
      ],
      "title": "UserResponse",
      "type": "object"
    }
  },
  "description": "Response envelope for successful user registration.",
  "properties": {
    "user": {
      "$ref": "#/$defs/UserResponse"
    },
    "tokens": {
      "$ref": "#/$defs/TokenResponse"
    }
  },
  "required": [
    "user",
    "tokens"
  ],
  "title": "RegisterResponse",
  "type": "object"
}