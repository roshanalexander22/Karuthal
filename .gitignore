# =============================================================================
# Sahaayi (സഹായി) — Comprehensive .gitignore
# =============================================================================

# =============================================================================
# SECRETS & ENVIRONMENT
# =============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
serviceAccountKey.json
google-services.json
GoogleService-Info.plist

# =============================================================================
# AI MODEL WEIGHTS (never commit large binary model files)
# =============================================================================
*.onnx
*.pt
*.pth
*.bin
*.tflite
*.pkl
*.h5
*.pb
*.ckpt
*.safetensors
models/weights/
ai-engine/models/
**/saved_model/
**/checkpoints/

# =============================================================================
# PYTHON / FASTAPI / AI-ENGINE
# =============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# lib/ (removed: Flutter source directory is named lib/)
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Translations
*.mo
*.pot

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject.db
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Celery beat schedule file
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# PEP 582
__pypackages__/

# ruff cache
.ruff_cache/

# =============================================================================
# DART / FLUTTER
# =============================================================================
# Flutter/Dart generated files
*.dart_tool/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
pubspec.lock
build/

# Flutter web build output
web/
!frontend/web/

# Flutter iOS build
ios/.generated/
ios/Flutter/App.framework
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/ephemeral/
ios/Flutter/app.flx
ios/Flutter/app.zip
ios/Flutter/flutter_assets/
ios/ServiceDefinitions.json
ios/Runner/GeneratedPluginRegistrant.*

# Dart generated code
*.g.dart
*.freezed.dart
*.gr.dart
*.config.dart
*.mocks.dart

# =============================================================================
# ANDROID / KOTLIN
# =============================================================================
# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/
gradle-wrapper.jar

# Local configuration file (sdk path, etc)
local.properties

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# Google Services (keep the template if exists, ignore the real one)
app/google-services.json

# Signing configs
*.jks
*.keystore
keystore.properties

# Android Lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# =============================================================================
# NODE.JS (tooling scripts, etc.)
# =============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
package-lock.json
yarn.lock
pnpm-lock.yaml

# =============================================================================
# DOCKER
# =============================================================================
# Do not ignore Dockerfiles or docker-compose.yml themselves
# but ignore runtime artifacts
docker/data/
postgres_data/
redis_data/
pgadmin_data/
.docker/

# =============================================================================
# IDE — VISUAL STUDIO CODE
# =============================================================================
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/
*.vsix

# =============================================================================
# IDE — INTELLIJ / ANDROID STUDIO / JETBRAINS
# =============================================================================
.idea/
*.iws
*.iml
*.ipr
out/
.idea_modules/

# =============================================================================
# IDE — XCODE (iOS)
# =============================================================================
xcuserdata/
*.xcscmblueprint
*.xccheckout
*.moved-aside
DerivedData/
*.hmap
*.ipa
*.xcuserstate
**/xcshareddata/WorkspaceSettings.xcsettings

# =============================================================================
# OPERATING SYSTEM FILES
# =============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# =============================================================================
# UPLOADS & GENERATED CONTENT
# =============================================================================
uploads/
media/
static/collected/

# =============================================================================
# LOGS
# =============================================================================
*.log
*.log.*
logs/
log/

# =============================================================================
# TEMPORARY FILES
# =============================================================================
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store

# =============================================================================
# TESTING ARTIFACTS
# =============================================================================
test-results/
test-output/
allure-results/
allure-report/
screenshots/
goldens/failures/

# =============================================================================
# DOCUMENTATION BUILD
# =============================================================================
docs/_build/
docs/site/
site/
