# ==============================================================================
# SAHAAYI PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure values before starting services.
# NEVER commit real credentials, production secrets, or private keys to git.

# APPLICATION
APP_NAME=Sahaayi
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=sahaayi-dev-secret-key-change-in-production-min-32-chars-long
API_V1_STR=/api/v1

# DATABASE (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sahaayi_db
POSTGRES_USER=sahaayi_user
POSTGRES_PASSWORD=sahaayi_secure_password
DATABASE_URL=postgresql+asyncpg://sahaayi_user:sahaayi_secure_password@localhost:5432/sahaayi_db

# CACHING & BROKER (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# AUTHENTICATION (JWT)
JWT_SECRET_KEY=sahaayi-jwt-secret-key-must-be-random-and-secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# AI ENGINE MICROSERVICE
AI_ENGINE_HOST=localhost
AI_ENGINE_PORT=8001
AI_ENGINE_URL=http://localhost:8001
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=optional-fallback-openai-key

# FILE STORAGE & UPLOADS
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,webp,m4a,wav,mp3

# CORS & NETWORKING
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8000

# NOTIFICATIONS (Firebase Cloud Messaging)
FIREBASE_PROJECT_ID=sahaayi-elder-care
FIREBASE_CREDENTIALS_PATH=./config/firebase-service-account.json

# OCR & UTILITIES
TESSERACT_CMD=/usr/bin/tesseract
TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
FFMPEG_CMD=/usr/bin/ffmpeg
